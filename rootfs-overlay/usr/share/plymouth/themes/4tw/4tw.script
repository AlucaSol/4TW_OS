Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
logo = Image("4TW-OS.png");
scale_x = Window.GetWidth() * 0.40 / logo.GetWidth();
scale_y = Window.GetHeight() * 0.40 / logo.GetHeight();
scale = Math.Min(scale_x, scale_y);
scaled = logo.Scale(logo.GetWidth() * scale, logo.GetHeight() * scale);
sprite = Sprite(scaled);
sprite.SetX((Window.GetWidth() - scaled.GetWidth()) / 2);
sprite.SetY((Window.GetHeight() - scaled.GetHeight()) / 2);
sprite.SetZ(100);
