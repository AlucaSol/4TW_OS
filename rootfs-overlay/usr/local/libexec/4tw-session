#!/bin/sh
# This is the kiosk account's login program, not an interactive shell.
[ "$#" -eq 0 ] || exit 2
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export MOZ_ENABLE_WAYLAND=1
export XDG_CACHE_HOME="$XDG_RUNTIME_DIR/cache"
export XDG_CONFIG_HOME=/etc/4tw/user-config
mkdir -p "$XDG_CACHE_HOME"
# Never inherit an offload request that selects a discrete GPU. Native Wayland
# rendering and hardware acceleration remain enabled.
unset DRI_PRIME __NV_PRIME_RENDER_OFFLOAD __GLX_VENDOR_LIBRARY_NAME VK_LAYER_NV_optimus
# Select only a card proven to drive the internal panel (or the sole card).
# Empty output means the topology is ambiguous and wlroots should autodetect.
gpu=$(/usr/local/bin/4tw-select-gpu)
case "$gpu" in
    /dev/dri/card[0-9]*) [ -c "$gpu" ] && export WLR_DRM_DEVICES="$gpu" ;;
esac
unset gpu
mode=$(/usr/bin/cat /run/4tw/mode 2>/dev/null)
case "$mode" in offline) config=/etc/4tw/sway-offline.conf ;; *) mode=online; config=/etc/4tw/sway-online.conf ;; esac
/usr/bin/dbus-run-session -- /usr/bin/sway --config "$config"
# Only the fixed failed-Wi-Fi action can change Online to Offline. Start a new
# compositor session in that one case; every other compositor exit powers off.
next=$(/usr/bin/cat /run/4tw/mode 2>/dev/null)
if [ "$mode" = online ] && [ "$next" = offline ]; then
    exec /usr/local/libexec/4tw-session
fi
exec /usr/bin/sudo -n /usr/local/sbin/4tw-poweroff
