#!/usr/bin/python3 -I
import subprocess
import sys
sys.path.insert(0, "/usr/local/lib/4tw")
from appliance import notify

if len(sys.argv) != 2 or sys.argv[1] not in {"up", "down"}:
    raise SystemExit(2)
try:
    result = subprocess.run(
        ["/usr/bin/sudo", "-n", "/usr/local/sbin/4tw-keyboard-backlight", sys.argv[1]],
        check=False, capture_output=True, text=True, timeout=5)
    value = result.stdout.strip()
    if result.returncode == 0 and value.isdecimal():
        body = "Keyboard: Off" if int(value) == 0 else f"Keyboard: {int(value)}%"
    else:
        body = "Keyboard backlight unavailable"
except (OSError, subprocess.TimeoutExpired):
    body = "Keyboard backlight unavailable"
notify(body)
